{
  "name": "2048-reasons",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rescript build && vite build",
    "check": "bun run res:format && bun run res:build && bun run test && bun run build",
    "prepare": "lefthook install",
    "res:build": "rescript build",
    "res:clean": "rescript clean",
    "res:format": "rescript format src/App.res src/Controls.res src/Game.res src/Game_spec.res src/Grid.res src/Index.res src/ScoreBoard.res src/SwipeZone.res src/Tile.res src/Utils.res",
    "test": "bun test ./src/Game_spec.res.js"
  },
  "dependencies": {
    "@rescript/react": "^0.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lefthook": "^2.1.10",
    "rescript": "^12.0.0-alpha.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.1.0"
  }
}
