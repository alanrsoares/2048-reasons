{
  "name": "2048-reasons",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rescript build && vite build",
    "check": "bun run res:gen && bun run res:format && bun run res:build && bun run test && bun run build",
    "prepare": "lefthook install",
    "res:build": "rescript build",
    "res:clean": "rescript clean",
    "res:format": "rescript format src/App.res src/Index.res src/components/Controls.res src/components/Grid.res src/components/ScoreBoard.res src/components/SwipeZone.res src/components/Tile.res src/engine/Game.res src/engine/Game_sim.res src/engine/Game_spec.res src/lib/StyledCva.res src/lib/StyledCva_spec.res src/lib/Utils.res tests/smoke/App_smoke_spec.res scripts/GenStyledCva.res",
    "res:gen": "rescript build && bun run ./scripts/GenStyledCva.res.js",
    "sim": "rescript build && bun run ./src/engine/Game_sim.res.js",
    "test": "bun test ./src/engine/Game_spec.res.js ./src/lib/StyledCva_spec.res.js ./tests/smoke/App_smoke_spec.res.js",
    "test:unit": "bun test ./src/engine/Game_spec.res.js ./src/lib/StyledCva_spec.res.js",
    "test:smoke": "bun test ./tests/smoke/App_smoke_spec.res.js"
  },
  "dependencies": {
    "@rescript/react": "^0.15.0",
    "@styled-cva/react": "^0.7.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lefthook": "^2.1.10",
    "rescript": "^12.0.0-alpha.9",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.1.0"
  }
}
